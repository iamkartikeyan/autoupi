# Auto-UPI Environment Configuration Example

# Frontend Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_CURRENCY=USD

# Server Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=autoupi_super_secret_jwt_key_development_2026_demo_secure
CORS_ORIGIN=http://localhost:3000

# Supabase / PostgreSQL (Optional - In-Memory Fallback Active when unset)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Twilio SMS / OTP (Optional - Demo fallback active with OTP '123456' when unset)
TWILIO_ACCOUNT_SID=AC_dummy_account_sid_for_demo
TWILIO_AUTH_TOKEN=dummy_auth_token_for_demo
TWILIO_PHONE_NUMBER=+1234567890

# FX Rates API (Optional - Built-in realistic FX quote engine active when unset)
FX_API_KEY=dummy_fx_api_key
FX_API_BASE_URL=https://api.exchangerate.host

# Blockchain EVM & Smart Contracts
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
